// MODELLO DI PACCHETTO HOMEBREW (da copiare in un file .json SENZA i commenti e riempire).
// Si importa dalla schermata Homebrew → "Importa pacchetto". Tutte le liste sono facoltative.
// Gli id: minuscoli, lettere, numeri e "_", iniziano con una lettera. Conviene il prefisso "hb_" per non scontrarsi coi dati di gioco.
// Le monete sono in RAME: 1 mo = 100. Il peso è in libbre (lb). Le distanze in piedi (ft) per la gittata delle armi.
{
  "schemaVersion": 1,          // obbligatorio: versione del formato
  "name": "Il mio pacchetto",  // solo un'etichetta

  "weapons": [{
    "id": "hb_mia_arma",
    "name": { "it": "Mia arma" },
    "description": "",
    "category": "martial",          // simple | martial
    "kind": "melee",                // melee | ranged
    "damage": "1d8",                // dadi ("2d6") o numero fisso ("1")
    "damageType": "slashing",       // id di un tipo di danno: slashing, piercing, fire, radiant...
    "properties": ["versatile"],    // id di proprietà: light, finesse, heavy, thrown, versatile, two_handed, reach, loading, ammunition
    "versatileDamage": "1d10",      // solo se è Versatile
    "range": { "normal": 80, "long": 320 }, // solo a distanza o lanciata
    "mastery": "sap",               // id di una maestria: cleave, graze, nick, push, sap, slow, topple, vex
    "weight": 3,
    "cost": 1500                    // in rame
  }],

  "armors": [{
    "id": "hb_mia_armatura",
    "name": { "it": "Mia armatura" },
    "category": "medium",           // light | medium | heavy | shield
    "baseAc": 14,                   // per lo scudo è il bonus
    "dexCap": 2,                    // massimo di Destrezza; null = nessun limite; 0 = niente Destrezza
    "strRequired": 0,
    "donMinutes": 5,                // minuti per indossarla
    "stealthDisadvantage": false,
    "weight": 20, "cost": 5000
  }],

  "items": [{
    "id": "hb_mio_oggetto",
    "name": { "it": "Mio oggetto" },
    "category": "Oggetto magico",
    "weight": 1, "cost": 0,
    "attunement": true              // richiede sintonia
  }],

  "feats": [{
    "id": "hb_mio_talento",
    "name": { "it": "Mio talento" },
    "description": "Testo che il giocatore legge.",
    "category": "general",          // origin | general | fighting_style | epic_boon
    "prerequisites": ["level>=4"],  // condizioni, tutte da soddisfare (level>=N, ability:str>=13...)
    "repeatable": false,
    "effects": [                    // ciò che cambia nella scheda; l'editor ne propone un catalogo
      { "op": "acBonus", "value": 1 },
      { "op": "speedBonus", "value": 10 },
      { "op": "initiativeBonus", "value": 2 },
      { "op": "resistance", "types": ["fire"] },
      { "op": "sense", "kind": "darkvision", "range": 60 },
      { "op": "attackBonus", "value": 1, "attackType": "ranged" },   // any | melee | ranged
      { "op": "saveBonus", "value": 1, "ability": "wis" },            // senza "ability" = tutti
      { "op": "grantSkillProficiency", "skills": ["stealth"], "expertise": false },
      { "op": "abilityScoreIncrease", "abilities": ["str"], "amount": 1, "cap": 20 },
      { "op": "grantSpell", "spell": "hb_mia_magia", "mode": "alwaysPrepared" } // alwaysPrepared | cantrip | known
    ]
  }],

  "spells": [{
    "id": "hb_mia_magia",
    "name": { "it": "Mia magia" },
    "description": "",
    "level": 1,                     // 0 = trucchetto
    "school": "evocation",          // abjuration conjuration divination enchantment evocation illusion necromancy transmutation
    "classes": ["wizard"],          // bard cleric druid paladin ranger sorcerer warlock wizard
    "castingTime": { "unit": "action", "amount": 1 }, // action | bonus_action | reaction | minute | hour
    "range": "18 metri",
    "components": { "v": true, "s": true, "m": false },
    "duration": "Istantanea",
    "concentration": false, "ritual": false,
    "resolution": "save_dex",       // none | save_str..save_cha | attack_melee | attack_ranged
    "summary": "Riga breve per l'elenco.",
    "higherLevels": ""
  }]
  ,

  // ---- contenuti del personaggio (stessa forma dei dati di gioco) ----
  "species": [{
    "id": "hb_mia_specie",
    "name": { "it": "Mia specie" },
    "sizes": ["medium", "small"],   // tiny | small | medium | large: se più di una, il giocatore sceglie
    "speed": 30,
    "traits": [{                    // ogni tratto ha il livello in cui si ottiene (di solito 1, 3 o 5)
      "id": "hb_mia_specie_vista", "name": { "it": "Vista nel buio" }, "level": 1,
      "effects": [{ "op": "sense", "kind": "darkvision", "range": 60 }],
      "usage": { "uses": "pb", "recharge": "long_rest" },   // usi limitati (numero, formula o { "table": [20 valori] })
      "choices": [{ "id": "hb_mia_specie_dono", "label": { "it": "Dono" }, "count": 1, "options": [
        { "id": "a", "name": { "it": "Dono A" }, "effects": [{ "op": "speedBonus", "value": 10 }] },
        { "id": "b", "name": { "it": "Dono B" }, "effects": [{ "op": "acBonus", "value": 1 }] }] }]
    }]
  }],

  "backgrounds": [{                 // i talenti homebrew del pacchetto si leggono prima dei background
    "id": "hb_mio_background",
    "name": { "it": "Mio background" },
    "abilityOptions": ["con", "wis", "cha"],   // le 3 caratteristiche aumentabili
    "skills": ["perception", "survival"],      // 2 abilità
    "tool": "gaming",                          // id di uno strumento oppure artisan | gaming | musical (a scelta)
    "feat": "hb_mio_talento",                  // un talento di Origine, anche homebrew
    "equipment": { "A": { "items": [], "gp": 10 }, "B": { "items": [], "gp": 50 } }  // items: [{ "item": "id", "qty": 1 }]; segnaposto "$tool", "$gaming_set", "$instrument"
  }],

  "classes": [{
    "id": "hb_mia_classe",
    "name": { "it": "Mia classe" },
    "hitDie": 8,                    // 6 | 8 | 10 | 12
    "primaryAbility": ["wis"], "saves": ["con", "wis"],
    "skillChoices": { "count": 2, "from": "any" },     // "any" o una lista di abilità
    "armorTraining": ["light", "medium", "shield"], "weaponProficiency": ["simple", "martial"],
    "caster": "none",               // none | full | half | third | pact. Se incantatrice: spellAbility, spellList, spellSlots (20 righe) e la colonna "preparati"
    "subclassLevel": 3,
    "table": { "rune": [1, 1, 2, 2, 2, 3, 3, 3, 4, 4, 4, 5, 5, 5, 6, 6, 6, 6, 7, 7] },   // colonne a piacere, 20 valori ciascuna
    "equipment": { "A": { "items": [], "gp": 100 } },
    "features": [{ "id": "hb_mia_classe_p1", "name": { "it": "Primo privilegio" }, "level": 1, "description": "" }],
    "choices": [{ "id": "hb_mia_classe_skills", "label": { "it": "Abilità" }, "count": 2, "source": "skills" }]   // l'editor genera questa scelta da solo
  }],

  "subclasses": [{
    "id": "hb_mia_sottoclasse",
    "name": { "it": "Mia sottoclasse" },
    "classId": "hb_mia_classe",     // una classe ufficiale (es. "fighter") o homebrew
    "features": [{ "id": "hb_mia_sottoclasse_p3", "name": { "it": "Privilegio di sottoclasse" }, "level": 3 }]
  }],

  // ---- fondamenti ----
  "languages": [{ "id": "hb_ignico", "name": { "it": "Ignico" }, "extra": { "rarity": "rare" } }],   // standard | rare
  "damageTypes": [{ "id": "hb_sonico", "name": { "it": "Sonico" } }],
  "conditions": [{ "id": "hb_brillante", "name": { "it": "Brillante" }, "description": "Emetti luce." }]
}
