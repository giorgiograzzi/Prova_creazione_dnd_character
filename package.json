    "@vitejs/plugin-react": "^6.1.1",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
